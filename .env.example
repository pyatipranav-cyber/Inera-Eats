# Copy this file to .env for local development (never commit .env).
# On Vercel, add the same two variables under Project → Settings → Environment Variables.
# Get test keys from Razorpay Dashboard → Account & Settings → API Keys (Test Mode).
# Leave them empty to run the app with the built-in demo checkout.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
